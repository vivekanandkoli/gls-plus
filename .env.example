# Copy to .env.local and fill with the values for the environment you're pointing at
# (local Supabase, staging, or prod). See docs/PHASE-0-SETUP.md.

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only — never expose to the browser
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct Postgres connection for migrations/scripts (optional; CLI can derive it)
# SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
